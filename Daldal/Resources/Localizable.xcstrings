      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريق غارق بالمياه"
          }
        }
      }
    },
    "For clearer directions, download an Enhanced Arabic voice in Settings › Accessibility › Spoken Content › Voices › Arabic.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتوجيه أوضح، نزّل صوتاً عربياً محسّناً من الإعدادات › تسهيلات الاستخدام › المحتوى المنطوق › الأصوات › العربية."
          }
        }
      }
    },
    "Gone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زال"
          }
        }
      }
    },
    "Hazard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطر على الطريق"
          }
        }
      }
    },
    "Help with live traffic": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساهم في حركة المرور المباشرة"
