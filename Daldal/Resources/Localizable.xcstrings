{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ of %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ من %2$@"
          }
        }
      }
    },
    "+%@ traffic": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ ازدحام"
          }
        }
      }
    },
    "AR is for walking. It pauses while you're in a vehicle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الواقع المعزز مخصص للمشي، ويتوقف أثناء وجودك في مركبة."
          }
        }
      }
    },
    "Accident": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حادث"
          }
        }
      }
    },
    "Allow camera access in Settings to see sites in AR.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا من الإعدادات لرؤية المواقع بالواقع المعزز."
          }
        }
      }
    },
    "Arrival": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول"
          }
        }
      }
    },
    "Check your connection and try again. Offline search arrives with downloadable maps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك وحاول مرة أخرى. سيتوفر البحث دون إنترنت مع الخرائط القابلة للتنزيل."
          }
        }
      }
    },
    "Checking files…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق من الملفات…"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق"
          }
        }
      }
    },
    "Copy coordinates": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ الإحداثيات"
          }
        }
      }
