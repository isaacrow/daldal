    "Couldn't get directions right now. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على الاتجاهات الآن. حاول بعد قليل."
          }
        }
