    "No internet connection. The download continues when you're back online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت. سيستمر التنزيل عند عودة الاتصال."
