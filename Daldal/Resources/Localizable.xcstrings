      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسرع"
          }
        }
      }
    },
    "Finding a better route…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إيجاد طريق أفضل…"
