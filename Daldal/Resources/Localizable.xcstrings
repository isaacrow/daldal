      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل إلى ثنائي الأبعاد"
          }
        }
      }
    },
    "Switch to 3D": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل إلى ثلاثي الأبعاد"
          }
        }
      }
    },
    "Tap to set": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للتعيين"
          }
        }
      }
    },
    "Thanks. Other drivers will see it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكراً. سيراه السائقون الآخرون."
          }
        }
      }
    },
    "The download didn't finish. Tap Retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل التنزيل. اضغط إعادة المحاولة."
          }
        }
      }
    },
    "There's no drivable route to this place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد طريق صالح للقيادة إلى هذا المكان."
          }
        }
      }
    },
    "This iPhone doesn't support AR.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الآيفون لا يدعم الواقع المعزز."
          }
