          }
        }
      }
    },
    "This iPhone doesn't support Apple Intelligence. The ElevenLabs assistant can be set up instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الآيفون لا يدعم ذكاء Apple. يمكنك إعداد مساعد ElevenLabs بدلاً منه."
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings to use the free assistant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل ذكاء Apple من الإعدادات لاستخدام المساعد المجاني."
          }
        }
      }
    },
    "Apple Intelligence is still downloading. Try again in a few minutes.": {
