    "Mount your phone facing the road. Keep your eyes on the road; Daldal will speak if a car gets close.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت هاتفك باتجاه الطريق، وأبقِ عينيك على الطريق؛ سينبّهك دلدل بالصوت إذا اقتربت سيارة."
          }
        }
      }
    },
