      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض موقعي"
          }
        }
      }
    },
    "Some map files were damaged in transfer. Tap Retry to download them again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفت بعض ملفات الخريطة أثناء النقل. اضغط إعادة المحاولة لتنزيلها مجدداً."
          }
        }
      }
    },
    "Speed limit %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حد السرعة %lld"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ"
          }
        }
      }
    },
    "Still there?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ما زال موجوداً؟"
          }
        }
      }
    },
    "Switch": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل"
