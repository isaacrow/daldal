      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نتائج في العراق"
          }
        }
      }
    },
    "Not enough free space. The Iraq map needs about %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة كافية. تحتاج خريطة العراق إلى نحو %@."
