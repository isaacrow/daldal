    "Couldn't connect to the assistant. Check your internet and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بالمساعد. تحقق من الإنترنت وحاول مرة أخرى."
          }
        }
      }
    },
    "Couldn't get directions right now. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على الاتجاهات الآن. حاول بعد قليل."
