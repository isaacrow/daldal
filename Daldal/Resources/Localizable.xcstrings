    },
    "End this trip?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء هذه الرحلة؟"
          }
        }
      }
    },
    "End trip": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء الرحلة"
          }
        }
      }
