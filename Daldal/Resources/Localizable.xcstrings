      }
    },
    "Downloading… you can leave the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التنزيل… يمكنك مغادرة التطبيق."
          }
        }
      }
    },
    "Drag sideways to line the marker up with the site.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب جانبياً لمحاذاة العلامة مع الموقع."
