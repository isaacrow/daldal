{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دلدل"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم دلدل الكاميرا لعرض المعالم والمواقع التراثية بالواقع المعزز في أماكنها الحقيقية."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم دلدل موقعك لعرض مكانك على الخريطة، والعثور على الأماكن القريبة، ووضع المواقع التراثية بالواقع المعزز."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم دلدل الميكروفون فقط أثناء حديثك مع المساعد الصوتي."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل دلدل ما تقوله للمساعد إلى نص على جهازك."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم دلدل مستشعرات الحركة لمتابعة سيارتك بسلاسة بين تحديثات الموقع في المسح أثناء القيادة."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع خيار «دائماً» ينبهك دلدل عند وصولك إلى معلم يمكنك استكشافه بالواقع المعزز، حتى عندما يكون التطبيق مغلقاً."
          }
        }
      }
    }
  }
}